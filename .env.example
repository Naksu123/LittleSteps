# ==============================================================================
# LittleSteps Cloud-Based Kindergarten LMS — Environment Configuration Template
# Copy this file to .env (or backend/.env & frontend/.env.local) for local runs.
# NEVER commit real credentials or secrets to source control.
# ==============================================================================

# --- Application ---
APP_NAME=LittleSteps LMS
APP_ENV=development
DEBUG=true
APP_TIMEZONE=Asia/Manila

# --- Database & Connection Pooling ---
# Local zero-Docker fallback (SQLite):
# DATABASE_URL=sqlite:///./littlesteps_dev.db
# Local Docker PostgreSQL 16 (or AWS RDS PostgreSQL 16 endpoint):
DATABASE_URL=postgresql+psycopg://littlesteps:littlesteps_dev@postgres:5432/littlesteps
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# --- Startup Automation ---
RUN_MIGRATIONS=true
SEED_ON_START=false

# --- Authentication & Security ---
# Generate a strong random 64-char secret for production (stored in AWS Secrets Manager)
JWT_SECRET_KEY=change-this-local-dev-secret-before-production-deployment
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
# Private access code required on the hidden /staff-gate Teacher & Admin portal.
# Change this to a strong secret (>= 12 chars) known only to school staff / admins.
STAFF_ACCESS_CODE=LS-Staff-Private-2026!

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Media Storage & AWS Integration (Local FS for Dev, Amazon S3 for Production) ---
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=littlesteps-media-dev
S3_ENDPOINT_URL=
CLOUDFRONT_DOMAIN=
AWS_SECRETS_MANAGER_ARN=

# --- CloudWatch Structured Logging ---
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Frontend ---
# Use 127.0.0.1 instead of localhost on Windows to avoid ~2s IPv6 (::1) fallback latency
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
